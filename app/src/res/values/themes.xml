<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme: shown by the window while the app launches. -->
    <style name="Theme_Aether_Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
    </style>
    <!-- Main theme (light). System dark mode handled via values-night. -->
    <style name="Theme_Aether" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
</resources>
