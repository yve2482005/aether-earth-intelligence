# AETHER Earth Intelligence — environment template.
# Copy to .env and fill in ONLY what you use. Never commit a filled .env
# or any real credential. Placeholders only — no real values here.
# Sheets / Drive are OFF by default; the local SQLite database works alone.

# Google Sheets mirror (needs a service account + shared spreadsheet)
AETHER_SHEETS_ENABLED=0
AETHER_SHEETS_SPREADSHEET_ID=

# Google Drive backup (needs the same service account)
AETHER_DRIVE_ENABLED=0

# NASA FIRMS wildfire detections (free key from https://firms.modaps.eosdis.nasa.gov/api/area/)
# Leave empty and the FIRMS adapter stays disabled (status pending_verification).
FIRMS_MAP_KEY=

# Optional: Firebase Cloud Messaging key for push alerts (via secure vault, never here)
FCM_SERVER_KEY=
